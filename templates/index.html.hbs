{{#*inline "page"}}
<div class="container-fluid">
  <div class="row">
    {{> sidebar}}
    <main role="main" class="col-md-9 ml-sm-auto col-lg-10 pt-3 px-4">
      <div class="home-hero">
        <h1>Multi Tool</h1>
        <p>
          A self-contained toolkit of small, stateless developer text utilities.
          Pick a tool below, paste your text, and copy the output. Every tool is
          also a plain <code>GET /api/&lt;slug&gt;</code> endpoint.
        </p>
      </div>
      <div class="home-grid">
        {{{tiles}}}
      </div>
    </main>
  </div>
</div>
{{/inline}} {{> layout}}